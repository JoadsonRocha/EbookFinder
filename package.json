{
  "name": "ebookfinder",
  "version": "1.0.0",
  "description": "Organizador e leitor inteligente de e-books e documentos digitais locais",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win",
    "build:msi": "electron-builder --win msi",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:android": "npx cap sync && npx cap open android"
  },
  "author": "Joadson Rocha <joadson.dev@gmail.com>",
  "build": {
    "appId": "com.ebookfinder.app",
    "productName": "EbookFinder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "ia_config_bundle.json"
    ],
    "win": {
      "icon": "app/ebookFinder.ico",
      "publisherName": "Joadson Rocha",
      "target": [
        "nsis",
        "msi",
        "portable"
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "upgradeCode": "d4e2d31c-3b95-46f8-9a25-e593439b1a20"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "adm-zip": "^0.5.16",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "electron": "^39.1.1",
    "electron-builder": "^25.1.8"
  }
}
